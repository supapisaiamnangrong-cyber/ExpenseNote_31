<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/btn_clear_bg"
    android:padding="24dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- การ์ดหลัก -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/btn_add_bg"
            android:padding="20dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- หัวข้อแอป -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="บันทึกค่าใช้จ่ายประจำวัน"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="จดทุกบาทที่ใช้วันนี้ให้ครบเลยนะ"
                android:textSize="16sp"
                android:textColor="#666266"
                android:layout_marginBottom="16dp" />

            <!-- ช่องกรอกจำนวนเงิน -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="โปรดใส่จำนวนเงิน (เป็นบาท)"
                android:textColor="#555555"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FFCDD2"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="numberDecimal"
                android:hint="เช่น 100 หรือ 10.25"
                android:textColor="#333333"
                android:textColorHint="#888888"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <!-- ช่องคำอธิบาย -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="คำอธิบาย"
                android:textColor="#555555"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FFCDD2"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:hint="เช่น ข้าวกลางวัน, ค่าเดินทาง"
                android:textColor="#333333"
                android:textColorHint="#888888"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!-- ปุ่มกด -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#F8BBD0"
                    android:text="เคลียร์"
                    android:textColor="#101010" />

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="เพิ่มรายการ"
                    android:textColor="#181718"
                    android:backgroundTint="#F8BBD0" />
            </LinearLayout>

            <!-- เส้นคั่น -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E91E63"
                android:layout_marginBottom="16dp" />

            <!-- รายการล่าสุดและยอดรวม -->
            <TextView
                android:id="@+id/tvRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="รายการล่าสุด: -"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ยอดรวมวันนี้: 0.00 บาท"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>